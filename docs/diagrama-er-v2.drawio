etry x="236" width="234" height="30" as="geometry" /></mxCell><mxCell id="v2_acctchg_r9" parent="v2_acctchg" vertex="1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;" value=""><mxGeometry y="300" width="470" height="30" as="geometry" /></mxCell><mxCell id="v2_acctchg_r9_c0" parent="v2_acctchg_r9" vertex="1" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;overflow=hidden;whiteSpace=wrap;html=1;" value=""><mxGeometry x="0" width="46" height="30" as="geometry" /></mxCell><mxCell id="v2_acctchg_r9_c1" parent="v2_acctchg_r9" vertex="1" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;fontStyle=5;overflow=hidden;whiteSpace=wrap;html=1;" value="changed_at"><mxGeometry x="46" width="74" height="30" as="geometry" /></mxCell><mxCell id="v2_acctchg_r9_c2" parent="v2_acctchg_r9" vertex="1" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;fontStyle=5;overflow=hidden;whiteSpace=wrap;html=1;" value="TIMESTAMPTZ"><mxGeometry x="120" width="116" height="30" as="geometry" /></mxCell><mxCell id="v2_acctchg_r9_c3" parent="v2_acctchg_r9" vertex="1" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;fontStyle=5;overflow=hidden;whiteSpace=wrap;html=1;" value="Cuando"><mxGeometry x="236" width="234" height="30" as="geometry" /></mxCell><mxCell id="v2_leyenda" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;" value="&lt;b&gt;MODELO v2.0&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;v1.0&lt;/b&gt; &amp;#8212; diagrama de diseno del equipo (12 entidades, sin reservas)&lt;br&gt;&lt;b&gt;v1.5&lt;/b&gt; &amp;#8212; lo que desarrollo implemento: Client y LoginAttempt&lt;br&gt;&lt;b&gt;v2.0&lt;/b&gt; &amp;#8212; esta version: une las dos, corrige defectos y completa&lt;br&gt;&lt;br&gt;&lt;b&gt;Codigo de color&lt;/b&gt;&lt;br&gt;&amp;#9632; blanco &amp;#8212; entidad del diseno del equipo (v1.0), con correcciones&lt;br&gt;&amp;#9632; naranja &amp;#8212; ya implementado en Java (v1.5), no se toca&lt;br&gt;&amp;#9632; verde &amp;#8212; aporte de esta version (v2.0)&lt;br&gt;&lt;br&gt;&lt;b&gt;Correcciones sobre v1.0&lt;/b&gt;&lt;br&gt;&amp;#183; document_number: era UUIDv7, es VARCHAR&lt;br&gt;&amp;#183; INTEGEER &amp;#8594; INTEGER · price &amp;#8594; NUMERIC(12,2)&lt;br&gt;&amp;#183; currency &amp;#8594; currency_id (es una FK)&lt;br&gt;&amp;#183; descripcion &quot;TODO&quot; y comentario &quot;Id del servicio&quot;&lt;br&gt;&amp;#183; nota &quot;fungibles y no consumibles&quot; se contradecia&lt;br&gt;&amp;#183; 3 cardinalidades mal ancladas&lt;br&gt;&amp;#183; Organization sin NIT (HU-002 lo exige)&lt;br&gt;&lt;br&gt;&lt;b&gt;Verificado contra PostgreSQL 16&lt;/b&gt;&lt;br&gt;19 tablas &#183; 26 FK &#183; 43 CHECK &#183; 21 UNIQUE &#183; 3 EXCLUDE &#183; 8 triggers"><mxGeometry x="1860" y="1500" width="420" height="560" as="geometry" /></mxCell><mxCell id="v2edge_0" parent="1" edge="1" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERoneToMany;startArrow=ERmandOne;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;strokeWidth=2;" source="mD61MMsF_7nLcNjdKK7C-517" target="v2_svcloc_r0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v2edge_1" parent="1" edge="1" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERoneToMany;startArrow=ERmandOne;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;strokeWidth=2;" source="mD61MMsF_7nLcNjdKK7C-398" target="v2_svcloc_r1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v2edge_2" par